# Copy to .env.local and fill in. .env.local is git-ignored.

# Notion personal access token (starts with ntn_), from notion.so/developers/tokens.
# An internal connection's API token also works. See README → Setup.
NOTION_TOKEN=

# The three Garden Within databases. Paste each database's link (Share → Copy link) or id.
# Point these at the template copy or at your personal Garden Within.
NOTION_SEEDS_DB=
NOTION_ROOTS_DB=
NOTION_GARDEN_DB=

# How answers are written: "claude-code" (default) runs your installed Claude Code
# with its own login; "api" calls the Claude API with the key below.
CLAUDE_BACKEND=claude-code

# Claude API key, only used when CLAUDE_BACKEND=api.
ANTHROPIC_API_KEY=

# Postgres with pgvector. Defaults to a local database named garden_within_rag.
DATABASE_URL=postgres:///garden_within_rag

# Separate database for made-up sample data (npm run sample:load). Must not be the
# real database above; the loader refuses if it could be.
SAMPLE_DATABASE_URL=postgres:///garden_within_sample

# Voyage AI API key for npm run embed, from the Voyage dashboard (dashboard.voyageai.com,
# or MongoDB Atlas → AI Models). See README → Sample data.
VOYAGE_API_KEY=

# npm run embed only embeds the sample database unless this is exactly "yes".
# Embedding sends written answers to Voyage. Read README → Privacy first.
EMBED_REAL_JOURNAL=

# Timezone used for "today", "last week" and so on. Defaults to the system timezone.
GARDEN_TIMEZONE=America/Vancouver
